{
  "name": "tailwind-material3",
  "version": "0.0.0",
  "description": "Material 3 Vue components styled with Tailwind CSS",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && cp src/theme.css dist/theme.css",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@material-symbols/svg-400": "^0.48.3",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^6",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
